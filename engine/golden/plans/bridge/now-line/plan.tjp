# Bridge fixture: a `now` line wins over options.now.
# Targets: the manifest gives now 2026-01-05T09:00:00Z, but the plan's own
# `now` line sets 2026-03-04-12:00. Expected: ok true; project.now is
# 2026-03-04T12:00:00Z; task review starts at ${now} (minute 3600).
project nowline "Now from the plan" 2026-03-02 +1m {
  now 2026-03-04-12:00
}

task review "Review" {
  start ${now}
  duration 1d
}
