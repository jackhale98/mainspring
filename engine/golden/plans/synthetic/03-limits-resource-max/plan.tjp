# Feature: resource limits with dailymax, weeklymax and monthlymax
# SPDX-License-Identifier: GPL-2.0-or-later
project limits03 "Resource maximums" 2026-01-05 - 2026-03-27 {
  now 2026-02-02-09:00
}

resource eve "Eve" {
  limits {
    dailymax 4h
    weeklymax 20h
    monthlymax 60h
  }
}

resource fay "Fay" {
  limits {
    dailymax 6h
  }
}

resource gus "Gus" {
}

task deliver "Deliveries" {
  task alpha "Alpha" {
    effort 12d
    allocate eve
  }
  task beta "Beta" {
    effort 10d
    allocate fay
  }
  task gamma "Gamma" {
    effort 8d
    depends !alpha
    allocate eve, gus
  }
  task delta "Delta" {
    effort 6d
    depends !beta
    allocate fay
  }
  task epsilon "Epsilon" {
    effort 6d
    depends !gamma
    allocate gus
  }
}
