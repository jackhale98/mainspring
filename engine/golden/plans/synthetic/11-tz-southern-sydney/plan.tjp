# Feature: timezone Australia/Sydney; southern-hemisphere DST (October and April); span across the year boundary; tasks also cross the 2026-10-04 and 2027-04-04 DST changes
# SPDX-License-Identifier: GPL-2.0-or-later
project sydney11 "Southern DST" 2026-09-21 - 2027-05-28 {
  timezone "Australia/Sydney"
  now 2026-12-10-09:00
}

resource tam "Tam" {
}

resource uma "Uma" {
}

task southern "Southern hemisphere" {
  task ferry "Across year boundary" {
    start 2026-12-21-09:00
    effort 15d
    allocate tam
  }
  task summer "Summer work" {
    start 2027-01-11-09:00
    effort 10d
    depends !ferry
    allocate uma
  }
  task octwork "Across October change" {
    start 2026-09-28-09:00
    effort 8d
    allocate uma
  }
  task aprwork "Across April change" {
    start 2027-03-30-09:00
    effort 8d
    allocate tam
  }
  task audit "Audit" {
    effort 4d
    depends !summer
    allocate tam, uma
  }
}
