# Feature: task limits with min variants (dailymin, weeklymin) and per-resource limits
# Expected: native tj3 exits 0 with warnings. Task "b" has an impossible dailymin (10h per day, but a
# resource works 8h per day at most) and is reported as a warning. Per-resource limits are resource-level
# dailymax on rhea (allocation-level limits are not supported by tj3 3.8.4).
# SPDX-License-Identifier: GPL-2.0-or-later
project min04 "Task minimum limits" 2026-01-05 - 2026-03-27 {
  now 2026-02-02-09:00
}

resource pat "Pat" {
}

resource quy "Quy" {
}

resource rhea "Rhea" {
  limits {
    dailymax 3h
  }
}

task minimums "Minimum limits" {
  task a "A: achievable minimum" {
    effort 4d
    limits {
      dailymin 4h
    }
    allocate pat
  }
  task b "B: impossible minimum" {
    effort 3d
    limits {
      dailymin 10h
    }
    allocate quy
  }
  task c "C: weekly minimum" {
    effort 3d
    limits {
      weeklymin 8h
    }
    allocate rhea
  }
  task d "D: per-resource limits" {
    effort 4d
    depends !a
    allocate pat, rhea
  }
  task f "F: cannot fit the window" {
    effort 10d
    maxend 2026-01-09
    limits {
      dailymax 2h
    }
    allocate rhea
  }
  task e "E: after impossible" {
    effort 2d
    depends !b
    allocate quy
  }
}
