# Feature: priority contention; efficiency below 1 and above 1; overallocation warnings
# SPDX-License-Identifier: GPL-2.0-or-later
project prio17 "Priority and efficiency" 2026-01-05 - 2026-03-27 {
  now 2026-02-02-09:00
}

resource fox "Fox" {
  efficiency 0.5
}

resource gil "Gil" {
  efficiency 1.5
}

resource hana "Hana" {
  efficiency 1.0
}

task contend "Contention" {
  task urgent "Urgent" {
    priority 900
    effort 5d
    allocate fox
  }
  task normal "Normal" {
    effort 5d
    allocate fox
  }
  task low "Low" {
    priority 100
    effort 5d
    allocate fox
  }
  task fast "Fast worker" {
    effort 6d
    allocate gil
  }
  task slow "Slow worker" {
    effort 6d
    allocate fox
    depends !urgent
  }
  task double "Overloaded" {
    effort 8d
    allocate hana, gil
    allocate fox
  }
  task fin "Finish" {
    milestone
    depends !fast, !double
  }
}
