# Feature: global leaves (holiday, annual, special, sick, unpaid, unemployed); resource leaves; vacation
# SPDX-License-Identifier: GPL-2.0-or-later
project leaves13 "Calendars and leaves" 2026-01-05 - 2026-03-27 {
  now 2026-02-02-09:00
}

leaves holiday "Founders day" 2026-02-09
vacation "Company closure" 2026-02-23

resource xan "Xan" {
  leaves annual 2026-01-19 - 2026-01-23
  leaves sick 2026-02-04 - 2026-02-05
}

resource yui "Yui" {
  leaves unpaid 2026-02-11 - 2026-02-13
  leaves special "Study leave" 2026-03-02 - 2026-03-04
}

resource zed "Zed" {
  leaves unemployed 2026-01-05 - 2026-01-09
}

task calendar "Calendar work" {
  task kick "Kickoff" {
    start 2026-01-05
    effort 6d
    allocate xan, yui, zed
  }
  task mid "Mid" {
    effort 8d
    depends !kick
    allocate xan
  }
  task late "Late" {
    effort 6d
    depends !mid
    allocate yui, zed
  }
}
