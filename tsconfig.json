{
	"extends": "astro/tsconfigs/strictest",
	"include": [".astro/types.d.ts", "src/**/*", "tests/**/*", "*.ts"],
	"exclude": ["dist", "node_modules", "poc", "engine"],
	"compilerOptions": {
		"types": ["node"],
		"strict": true,
		"noImplicitAny": true,
		"paths": {
			"$lib/*": ["./src/lib/*"]
		}
	}
}
