---
// SPDX-License-Identifier: GPL-2.0-or-later
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/theme-light.css';
import '../styles/theme-dark.css';
import { strings } from '../lib/strings';
import { themeBootScript } from '../lib/state/theme';
import { sitePath } from '../lib/site-path';

interface Props {
	title?: string;
	/** The page description for search results and link previews. */
	description?: string;
	/** The app page: a fixed shell that never scrolls as a page, like a native app. */
	shell?: boolean;
}
const { title = strings.appName, description = strings.tagline, shell = false } = Astro.props;
---

<!doctype html>
<html lang="en" data-shell={shell ? '' : undefined}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
		<link rel="apple-touch-icon" href={sitePath('icons/apple-touch-icon.png')} />
		<link rel="manifest" href={sitePath('manifest.webmanifest')} />
		<!-- viewport-fit=cover lets the shell use the safe-area insets; the page still zooms (WCAG 1.4.4). -->
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ece7dc" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#080b10" media="(prefers-color-scheme: dark)" />
		<title>{title}</title>
		<!-- The theme before the first paint, so a dark user never sees a light flash. -->
		<script is:inline set:html={themeBootScript()}></script>
	</head>
	<body>
		<a class="skip" href="#main">
			{strings.skipToContent}
		</a>
		<slot />
	</body>
</html>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	html {
		-webkit-text-size-adjust: 100%;
		text-size-adjust: 100%;
	}
	body {
		margin: 0;
		background: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-sans);
		font-size: var(--text-md);
		line-height: var(--leading);
		-webkit-font-smoothing: antialiased;
	}
	/*
	 * The app shell behaves like a native app (phase-2.md 9.2): the page never scrolls or
	 * rubber-bands, the shell is exactly the viewport, and only the panels inside scroll. Chrome
	 * (bars, buttons, tabs) is not text to select and has no tap flash; the editor, inputs and
	 * the documentation keep normal selection.
	 */
	html[data-shell],
	html[data-shell] body {
		block-size: 100%;
		overflow: hidden;
		overscroll-behavior: none;
	}
	html[data-shell] body {
		position: fixed;
		inset: 0;
		inline-size: 100%;
		-webkit-user-select: none;
		user-select: none;
		-webkit-touch-callout: none;
		-webkit-tap-highlight-color: transparent;
		touch-action: manipulation;
	}
	html[data-shell] :is(input, textarea, select, .cm-editor, .selectable, .selectable *) {
		-webkit-user-select: text;
		user-select: text;
		-webkit-touch-callout: default;
	}
	/*
	 * A <select> draws like the inputs beside it, in both themes. WebKit paints its native grey
	 * fill and a white arrow whatever `background` says (a real iPhone does, and so does the
	 * Playwright WebKit), so the native look is turned off and the arrow is drawn here, in the text
	 * colour of the select. A select that has its own caret over it (a toolbar pill: its CSS sets
	 * `appearance: none` itself) says so with `data-own-caret` and keeps its own look. The selector
	 * outranks a component's one-class rule, so that a `background` shorthand there does not take
	 * the arrow away.
	 */
	html select:not([data-own-caret]) {
		appearance: none;
		-webkit-appearance: none;
		padding-inline-end: 2rem;
		background-image:
			linear-gradient(45deg, transparent 50%, currentColor 50%),
			linear-gradient(135deg, currentColor 50%, transparent 50%);
		background-position:
			calc(100% - 1.2rem) 50%,
			calc(100% - 0.85rem) 50%;
		background-size:
			0.35rem 0.35rem,
			0.35rem 0.35rem;
		background-repeat: no-repeat;
		text-overflow: ellipsis;
	}
	html select:not([data-own-caret]):disabled {
		opacity: 0.6;
	}
	:focus-visible {
		outline: 3px solid var(--color-focus);
		outline-offset: 2px;
	}
	.sr-only {
		position: absolute;
		inline-size: 1px;
		block-size: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}
	.skip {
		position: absolute;
		z-index: 100;
		left: var(--space-2);
		top: -4rem;
		padding: var(--space-2) var(--space-4);
		background: var(--color-accent);
		color: var(--color-accent-text);
		border-radius: var(--radius-sm);
	}
	.skip:focus {
		top: var(--space-2);
	}
</style>
