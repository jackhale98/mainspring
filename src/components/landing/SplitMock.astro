---
// SPDX-License-Identifier: GPL-2.0-or-later
// The product mock in the hero: Mainspring's Split view, editor beside Gantt, built in HTML and
// SVG from the same tokens as the app so it stays sharp and follows light and dark. Everything
// is sized in em; the frame is a size container and the mock's font size is a fraction of its
// width, so the whole picture scales as one. On a narrow frame the editor drops out and the
// chart gets the room. It is an illustration, so it is one labelled image for assistive tech.
import { tokenize, tokensToHtml } from '../../lib/landing-art';
import { landing } from '../../lib/landing-copy';
import { mockActiveLine, mockFirstLine, mockPlanText, samplePlan } from '../../lib/landing-sample';
import GanttChart from './GanttChart.astro';
import Mark from './Mark.astro';

const m = landing.mock;
const lines = mockPlanText.map((text, i) => ({
	n: mockFirstLine + i,
	active: i === mockActiveLine,
	html: tokensToHtml(tokenize(text)),
}));
---

<div class="frame" role="img" aria-label={landing.hero.mockLabel}>
	<div class="mock" aria-hidden="true">
		<div class="top">
			<span class="brand">
				<Mark size={28} />
				<span class="word">{m.brand}</span>
			</span>
			<span class="plan">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z M14 3v5h5"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linejoin="round"
					></path>
				</svg>
				{m.plan}
			</span>
			<span class="modes">
				{m.modes.map((label, i) => (
					<span class={i === m.activeMode ? 'mode on' : 'mode'}>{label}</span>
				))}
			</span>
			<span class="status">
				<i class="dot"></i>
				{m.status}
			</span>
		</div>

		<div class="panels">
			<section class="panel editor">
				<div class="tab">{m.plan}</div>
				<div class="lp-code code">
					{lines.map((l) => (
						<div class={l.active ? 'line active' : 'line'}>
							<span class="n">{l.n}</span>
							<span class="src" set:html={l.html + (l.active ? '<i class="caret"></i>' : '')} />
						</div>
					))}
				</div>
			</section>

			<section class="panel chart">
				<div class="wide">
					<GanttChart plan={samplePlan} uid="hero-w" selectedId="build" options={{ rowH: 40 }} />
				</div>
				<div class="narrow">
					<GanttChart
						plan={samplePlan}
						uid="hero-n"
						selectedId="build"
						options={{ nameCol: 58, days: 16, today: 8.5 }}
					/>
				</div>
				<div class="chips">
					<span class="chip">
						{m.chips[0]}
						<b class="caret-down"></b>
					</span>
					<span class="chip">{m.chips[1]}</span>
					<span class="chip">
						<i class="crit-dot"></i>
						{m.chips[2]}
					</span>
				</div>
			</section>
		</div>
	</div>
</div>

<style>
	.frame {
		container-type: inline-size;
	}
	.mock {
		font-size: 12px;
		font-size: calc(100cqw / 56);
		padding: 0.8em;
		border-radius: 1.5em;
		background: var(--lp-recess);
		border: 1px solid var(--lp-border);
		box-shadow: var(--lp-shadow-mock);
		color: var(--lp-text);
		font-family: var(--font-sans);
		line-height: 1.3;
	}

	/* Top bar, on the recessed ground */
	.top {
		display: grid;
		grid-template-columns: auto auto 1fr auto;
		align-items: center;
		gap: 1em;
		padding: 0.3em 0.5em 0.9em;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6em;
	}
	.brand :global(svg) {
		inline-size: 2em;
		block-size: 2em;
	}
	.word {
		font-family: var(--font-display);
		font-size: 1.9em;
		line-height: 1;
		letter-spacing: -0.01em;
	}
	.plan {
		display: flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.45em 0.9em;
		border-radius: 0.8em;
		background: var(--lp-panel);
		border: 1px solid var(--lp-border);
		font-size: 0.95em;
		font-weight: 500;
		color: var(--lp-muted);
	}
	.plan svg {
		inline-size: 1.2em;
		block-size: 1.2em;
	}
	.modes {
		justify-self: center;
		display: flex;
		gap: 0.2em;
		padding: 0.25em;
		border-radius: 999px;
		background: var(--lp-panel);
		border: 1px solid var(--lp-border);
		font-size: 0.95em;
		font-weight: 500;
		color: var(--lp-muted);
	}
	.mode {
		padding: 0.35em 1.1em;
		border-radius: 999px;
	}
	.mode.on {
		background: var(--lp-ink);
		color: var(--lp-on-ink);
		font-weight: 600;
	}
	.status {
		display: flex;
		align-items: center;
		gap: 0.55em;
		padding: 0.45em 0.9em;
		border-radius: 999px;
		background: var(--lp-panel);
		border: 1px solid var(--lp-border);
		font-size: 0.95em;
		font-weight: 500;
	}
	.dot {
		inline-size: 0.7em;
		block-size: 0.7em;
		border-radius: 50%;
		background: var(--lp-ok);
		box-shadow: 0 0 0 0.3em var(--lp-ok-halo);
	}

	/* Two floating panels */
	.panels {
		display: grid;
		grid-template-columns: 21em minmax(0, 1fr);
		gap: 0.8em;
	}
	.panel {
		border-radius: 1.1em;
		background: var(--lp-panel);
		border: 1px solid var(--lp-border);
		box-shadow:
			0 1px 2px rgb(60 45 10 / 0.05),
			0 6px 14px -8px rgb(60 45 10 / 0.12);
		overflow: hidden;
	}
	.tab {
		padding: 0.8em 1.2em;
		border-bottom: 1px solid var(--lp-border);
		font-family: var(--font-mono);
		font-size: 0.85em;
		font-weight: 500;
		color: var(--lp-muted);
	}
	.code {
		padding: 0.7em 0;
		font-size: 0.9em;
	}
	.line {
		display: flex;
		gap: 1em;
		padding: 0 1em 0 0;
		line-height: 1.55;
		white-space: pre;
		border-inline-start: 0.2em solid transparent;
	}
	.line.active {
		background: var(--lp-surface2);
		border-inline-start-color: var(--lp-steel);
	}
	.n {
		inline-size: 2.6em;
		flex: none;
		text-align: end;
		color: var(--lp-muted);
		font-variant-numeric: tabular-nums;
	}
	.src :global(.caret) {
		display: inline-block;
		inline-size: 0.14em;
		block-size: 1.15em;
		margin-inline-start: 0.1em;
		vertical-align: text-bottom;
		background: var(--lp-steel);
	}

	/* The chart panel, with the glass chips along the bottom */
	.chart {
		position: relative;
		display: flex;
		flex-direction: column;
	}
	.narrow {
		display: none;
	}
	.chips {
		display: flex;
		gap: 0.6em;
		margin-top: auto;
		padding: 0.8em 1em;
	}
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.4em 1em;
		border-radius: 999px;
		background: var(--lp-glass);
		border: 1px solid var(--lp-border-strong);
		box-shadow: var(--color-gantt-chip-shadow, 0 1px 2px rgb(40 30 10 / 0.06));
		font-size: 0.9em;
		font-weight: 500;
	}
	.crit-dot {
		inline-size: 0.65em;
		block-size: 0.65em;
		border-radius: 50%;
		background: var(--lp-ruby);
	}
	.caret-down {
		inline-size: 0.45em;
		block-size: 0.45em;
		margin-inline-start: 0.2em;
		border-inline-end: 1.5px solid currentColor;
		border-block-end: 1.5px solid currentColor;
		transform: translateY(-0.12em) rotate(45deg);
	}

	/* A narrow frame: the chart gets the room */
	@container (max-width: 560px) {
		.mock {
			font-size: calc(100cqw / 37);
		}
		.panels {
			grid-template-columns: minmax(0, 1fr);
		}
		.editor,
		.plan,
		.wide {
			display: none;
		}
		.narrow {
			display: block;
		}
		.top {
			grid-template-columns: auto 1fr auto;
		}
	}
</style>
