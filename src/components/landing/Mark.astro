// The brass coiled-mainspring mark of ADR-0009: a ring and a spiral of five turns.
interface Props {
	size?: number;
}
const { size = 28 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 28 28" aria-hidden="true" focusable="false">
	<circle cx="14" cy="14" r="12.5" fill="none" stroke="var(--lp-brass)" stroke-width="1.5"></circle>
	<path
		d="M14 14 m0 -1.6 a1.6 1.6 0 1 1 -1.6 1.6 a3.2 3.2 0 1 1 3.2 3.2 a4.8 4.8 0 1 1 -4.8 -4.8 a6.4 6.4 0 1 1 6.4 6.4 a8 8 0 1 1 -8 -8"
		fill="none"
		stroke="var(--lp-brass)"
		stroke-width="1.4"
		stroke-linecap="round"
	></path>
</svg>
