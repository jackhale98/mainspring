---
// SPDX-License-Identifier: GPL-2.0-or-later
// The Mainspring mark (ADR-0009, mark note) on the landing page: the same geometry as the app's
// Mark.svelte (src/lib/brand/mark.ts), static, in the theme's mark tokens. Decorative.
import { VIEWBOX, markForm, markGeometry, nextMarkId } from '../../lib/brand/mark';

interface Props {
	size?: number;
}
const { size = 28 } = Astro.props;
const g = markGeometry(markForm(size));
const c = VIEWBOX / 2;
const uid = nextMarkId();
const hl = g.highlight;
---

<svg
	class="mark"
	width={size}
	height={size}
	viewBox={`0 0 ${VIEWBOX} ${VIEWBOX}`}
	aria-hidden="true"
	focusable="false"
>
	<defs>
		<linearGradient
			id={`${uid}-b`}
			x1="0"
			y1="0"
			x2="0"
			y2={VIEWBOX}
			gradientUnits="userSpaceOnUse"
		>
			<stop offset="0" style="stop-color: var(--color-mark-brass-hi)"></stop>
			<stop offset=".45" style="stop-color: var(--color-mark-brass)"></stop>
			<stop offset="1" style="stop-color: var(--color-mark-brass-lo)"></stop>
		</linearGradient>
		<radialGradient
			id={`${uid}-r`}
			cx={g.jewelLight.cx}
			cy={g.jewelLight.cy}
			r={g.jewelLight.r}
			gradientUnits="userSpaceOnUse"
		>
			<stop offset="0" style="stop-color: var(--color-mark-ruby-hi)"></stop>
			<stop offset=".55" style="stop-color: var(--color-mark-ruby)"></stop>
			<stop offset="1" style="stop-color: var(--color-mark-ruby-lo)"></stop>
		</radialGradient>
	</defs>
	{g.arcs.map((d) => (
		<path d={d} fill="none" stroke={`url(#${uid}-b)`} stroke-width={g.arcWidth} />
	))}
	{g.innerRing !== null && (
		<circle
			cx={c}
			cy={c}
			r={g.innerRing}
			fill="none"
			stroke="var(--color-mark-brass)"
			stroke-width="0.6"
			opacity="0.55"
		/>
	)}
	{g.hairspring !== null && (
		<path
			d={g.hairspring}
			fill="none"
			stroke="var(--color-steel)"
			stroke-width={g.hairspringWidth}
			stroke-linecap="round"
		/>
	)}
	<circle
		cx={c}
		cy={c}
		r={g.jewel + 1.6}
		fill="none"
		stroke={`url(#${uid}-b)`}
		stroke-width="1.4"
	></circle>
	<circle cx={c} cy={c} r={g.jewel} fill={`url(#${uid}-r)`}></circle>
	<ellipse
		cx={hl.cx}
		cy={hl.cy}
		rx={hl.rx}
		ry={hl.ry}
		fill="var(--color-mark-glint)"
		opacity=".55"
		transform={`rotate(-35 ${hl.cx} ${hl.cy})`}
	></ellipse>
</svg>

<style>
	.mark {
		flex: none;
		display: block;
		overflow: visible;
	}
</style>
