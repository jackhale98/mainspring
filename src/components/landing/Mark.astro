---
// SPDX-License-Identifier: GPL-2.0-or-later
// The Mainspring mark (ADR-0009, "Mark change, 2026-11-16") on the landing page: the same
// geometry as the app's Mark.svelte (src/lib/brand/mark.ts), static, in the theme's mark tokens.
// `size` is the height; the width follows the mark's aspect. Decorative.
import { MARK_ASPECT, VIEWBOX_H, VIEWBOX_W, markForm, markGeometry } from '../../lib/brand/mark';

interface Props {
	size?: number;
}
const { size = 28 } = Astro.props;
const g = markGeometry(markForm(size));
const width = Math.round(size * MARK_ASPECT * 100) / 100;
---

<svg
	class="mark"
	width={width}
	height={size}
	viewBox={`0 0 ${VIEWBOX_W} ${VIEWBOX_H}`}
	aria-hidden="true"
	focusable="false"
>
	{g.arcs.map((d) => (
		<path class="arc" d={d} stroke-width={g.arcWidth} />
	))}
	<path class="band" d={g.band} stroke-width={g.bandWidth}></path>
</svg>

<style>
	.mark {
		flex: none;
		display: block;
		overflow: visible;
	}
	.arc,
	.band {
		fill: none;
	}
	.arc {
		stroke: var(--color-mark-arc);
	}
	.band {
		stroke: var(--color-mark-band);
	}
</style>
