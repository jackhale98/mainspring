// Credit and licence for the engine, kept short: what Mainspring runs, who made it, the GPL notice.
import { landing, landingLinks } from '../../lib/landing-copy';
import Accent from './Accent.astro';
import Icon from './Icon.astro';
import Mark from './Mark.astro';

const b = landing.builtOn;
---

<section class="lp-section" id={b.id} aria-labelledby="built-title">
	<div class="lp-wrap grid">
		<div class="copy">
			<p class="lp-eyebrow">{b.eyebrow}</p>
			<h2 id="built-title" class="lp-display lp-h2">
				<Accent before={b.before} accent={b.accent} after={b.after} />
			</h2>
			<!-- prettier-ignore -->
			<p class="lp-lead">{b.lead}<a class="credit" href={landingLinks.taskjuggler} rel="noopener">{b.creditLink}<Icon name="external" /></a>.</p>
			<p class="gpl">{b.gpl}</p>
		</div>

		<div class="plate">
			<div class="plate-head">
				<Mark size={34} />
				<h3 class="plate-title">{b.plateTitle}</h3>
			</div>
			<dl class="spec" aria-label={b.plateLabel}>
				{b.plate.map(([k, v]) => (
					<div class="row">
						<dt>{k}</dt>
						<dd class="lp-code">{v}</dd>
					</div>
				))}
			</dl>
		</div>
	</div>
</section>

<style>
	.grid {
		display: grid;
		gap: clamp(2.5rem, 2rem + 3vw, 5rem);
		align-items: center;
	}
	.credit {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		color: var(--lp-text);
		font-weight: 600;
		text-decoration-color: var(--lp-brass);
		text-underline-offset: 0.25em;
	}
	.credit :global(svg) {
		inline-size: 0.85rem;
		block-size: 0.85rem;
	}
	.gpl {
		max-inline-size: 38rem;
		margin: var(--space-4) 0 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--lp-muted);
	}

	/* A caliber plate: the spec of the movement, engraved on a brass-edged card */
	.plate {
		padding: 1.75rem;
		border: 1px solid var(--lp-brass-deep);
		border-radius: 1.5rem;
		background: var(--lp-panel);
		box-shadow:
			inset 0 0 0 5px var(--lp-panel),
			inset 0 0 0 6px var(--lp-border-strong),
			var(--lp-shadow-card);
	}
	.plate-head {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding-block-end: 1.1rem;
		border-block-end: 1px solid var(--lp-border-strong);
	}
	.plate-title {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.9rem;
		font-weight: 400;
		line-height: 1;
	}
	.spec {
		margin: 0;
	}
	.row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.15rem var(--space-4);
		padding: 0.8rem 0;
		border-block-end: 1px dotted var(--lp-border-strong);
	}
	.row:last-child {
		border-block-end: 0;
		padding-block-end: 0;
	}
	.row dt {
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--lp-muted);
	}
	.row dd {
		margin: 0;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--lp-text);
	}

	@media (min-width: 64rem) {
		.grid {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		}
	}
</style>
