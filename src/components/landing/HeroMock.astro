---
// SPDX-License-Identifier: GPL-2.0-or-later
// The hero's product mock: Mainspring's Gantt chart, with a small card in front showing the
// plain-text file behind it. Built in HTML and SVG from the same tokens as the app, so it stays
// sharp and follows light and dark. Everything is sized in em; the frame is a size container and
// the mock's font size is a fraction of its width, so the picture scales as one. On a narrow frame
// the card drops below the chart. It is an illustration, so it is one labelled image for
// assistive technology.
import { tokenize, tokensToHtml } from '../../lib/landing-art';
import { landing } from '../../lib/landing-copy';
import { mockActiveLine, mockFirstLine, mockPlanText, samplePlan } from '../../lib/landing-sample';
import GanttChart from './GanttChart.astro';
import Mark from './Mark.astro';

const m = landing.mock;
const lines = mockPlanText.map((text, i) => ({
	n: mockFirstLine + i,
	active: i === mockActiveLine,
	html: tokensToHtml(tokenize(text)),
}));
---

<div class="frame" role="img" aria-label={landing.hero.mockLabel}>
	<div class="mock" aria-hidden="true">
		<div class="top">
			<span class="brand">
				<Mark size={28} />
				<span class="word">{m.brand}</span>
			</span>
			<span class="modes">
				{m.modes.map((label, i) => (
					<span class={i === m.activeMode ? 'mode on' : 'mode'}>{label}</span>
				))}
			</span>
			<span class="status">
				<i class="dot"></i>
				{m.status}
			</span>
		</div>

		<section class="chart">
			<div class="wide">
				<GanttChart plan={samplePlan} uid="hero-w" selectedId="design" options={{ rowH: 40 }} />
			</div>
			<div class="narrow">
				<GanttChart
					plan={samplePlan}
					uid="hero-n"
					selectedId="design"
					options={{ nameCol: 58, days: 16, rowH: 38 }}
				/>
			</div>
			<div class="foot">
				<span class="chip">{m.chips[0]}</span>
				<span class="chip">
					<i class="crit-dot"></i>
					{m.chips[1]}
				</span>
			</div>
		</section>

		<aside class="file">
			<div class="file-head">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z M14 3v5h5"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linejoin="round"
					></path>
				</svg>
				<b>{m.plan}</b>
				<span class="caption">{m.fileCaption}</span>
			</div>
			<div class="lp-code code">
				{lines.map((l) => (
					<div class={l.active ? 'line active' : 'line'}>
						<span class="n">{l.n}</span>
						<span class="src" set:html={l.html} />
					</div>
				))}
			</div>
		</aside>
	</div>
</div>

<style>
	.frame {
		container-type: inline-size;
	}
	.mock {
		position: relative;
		font-size: 12px;
		font-size: calc(100cqw / 46);
		padding: 0.8em;
		border-radius: 1.5em;
		background: var(--lp-recess);
		border: 1px solid var(--lp-border);
		box-shadow: var(--lp-shadow-mock);
		color: var(--lp-text);
		font-family: var(--font-sans);
		line-height: 1.3;
	}

	/* Top bar, on the recessed ground */
	.top {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 1em;
		padding: 0.3em 0.5em 0.9em;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6em;
	}
	.brand :global(svg) {
		inline-size: 2em;
		block-size: 2em;
	}
	.word {
		font-family: var(--font-display);
		font-size: 1.9em;
		line-height: 1;
		letter-spacing: -0.01em;
	}
	.modes {
		justify-self: center;
		display: flex;
		gap: 0.2em;
		padding: 0.25em;
		border-radius: 999px;
		background: var(--lp-panel);
		border: 1px solid var(--lp-border);
		font-size: 0.95em;
		font-weight: 500;
		color: var(--lp-muted);
	}
	.mode {
		padding: 0.35em 1.1em;
		border-radius: 999px;
	}
	.mode.on {
		background: var(--lp-ink);
		color: var(--lp-on-ink);
		font-weight: 600;
	}
	.status {
		display: flex;
		align-items: center;
		gap: 0.55em;
		padding: 0.45em 0.9em;
		border-radius: 999px;
		background: var(--lp-panel);
		border: 1px solid var(--lp-border);
		font-size: 0.95em;
		font-weight: 500;
	}
	.dot {
		inline-size: 0.7em;
		block-size: 0.7em;
		border-radius: 50%;
		background: var(--lp-ok);
		box-shadow: 0 0 0 0.3em var(--lp-ok-halo);
	}

	/* The chart panel, with the glass chips under the bars */
	.chart {
		border-radius: 1.1em;
		background: var(--lp-panel);
		border: 1px solid var(--lp-border);
		box-shadow:
			0 1px 2px rgb(60 45 10 / 0.05),
			0 6px 14px -8px rgb(60 45 10 / 0.12);
		overflow: hidden;
	}
	.narrow {
		display: none;
	}
	.foot {
		display: flex;
		justify-content: flex-end;
		gap: 0.6em;
		padding: 0.9em 1em;
	}
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.4em 1em;
		border-radius: 999px;
		background: var(--lp-glass);
		border: 1px solid var(--lp-border-strong);
		font-size: 0.9em;
		font-weight: 500;
	}
	.crit-dot {
		inline-size: 0.65em;
		block-size: 0.65em;
		border-radius: 50%;
		background: var(--lp-ruby);
	}

	/* The plain-text file behind the chart: a card in front, over the empty corner of the chart */
	.file {
		position: absolute;
		inset-inline-start: 11.5em;
		inset-block-end: -2.4em;
		inline-size: 17em;
		border-radius: 1em;
		background: var(--lp-panel);
		border: 1px solid var(--lp-border-strong);
		box-shadow: var(--lp-shadow-mock);
		overflow: hidden;
	}
	.file-head {
		display: flex;
		align-items: center;
		gap: 0.55em;
		padding: 0.7em 1em;
		border-block-end: 1px solid var(--lp-border);
		font-size: 0.85em;
		color: var(--lp-muted);
	}
	.file-head svg {
		inline-size: 1.3em;
		block-size: 1.3em;
		flex: none;
	}
	.file-head b {
		font-family: var(--font-mono);
		font-weight: 600;
		color: var(--lp-text);
	}
	.caption {
		margin-inline-start: auto;
		padding: 0.15em 0.6em;
		border-radius: 999px;
		background: var(--lp-brass-wash);
		color: var(--lp-brass-text);
		font-size: 0.8em;
		font-weight: 600;
		white-space: nowrap;
	}
	.code {
		padding: 0.5em 0;
		font-size: 0.82em;
	}
	.line {
		display: flex;
		gap: 0.9em;
		padding-inline-end: 0.8em;
		line-height: 1.6;
		white-space: pre;
		border-inline-start: 0.2em solid transparent;
	}
	.line.active {
		background: var(--lp-brass-wash);
		border-inline-start-color: var(--lp-brass-deep);
	}
	.n {
		inline-size: 1.9em;
		flex: none;
		text-align: end;
		color: var(--lp-muted);
		font-variant-numeric: tabular-nums;
	}

	/* A narrow frame: the chart gets the room and the file card sits below it */
	@container (max-width: 560px) {
		.mock {
			font-size: calc(100cqw / 37);
		}
		.wide {
			display: none;
		}
		.narrow {
			display: block;
		}
		.file {
			position: static;
			inline-size: auto;
			margin-block-start: 0.8em;
			box-shadow: 0 6px 14px -8px rgb(60 45 10 / 0.18);
		}
		.caption {
			display: none;
		}
	}
</style>
