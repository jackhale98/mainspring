---
// SPDX-License-Identifier: GPL-2.0-or-later
// A short FAQ. All answers are shown, so a reader scans them without clicking and the page needs
// no script.
import { landing } from '../../lib/landing-copy';
import Accent from './Accent.astro';

const f = landing.faq;
---

<section class="lp-section band" id={f.id} aria-labelledby="faq-title">
	<div class="lp-wrap">
		<p class="lp-eyebrow">{f.eyebrow}</p>
		<h2 id="faq-title" class="lp-display lp-h2">
			<Accent before={f.before} accent={f.accent} after={f.after} />
		</h2>
		<div class="grid">
			{f.items.map((item) => (
				<div class="qa">
					<h3>{item.q}</h3>
					<p>{item.a}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.band {
		border-block-start: 1px solid var(--lp-border);
		background: linear-gradient(var(--lp-bg), var(--lp-surface2));
	}
	.grid {
		display: grid;
		gap: var(--space-4);
		margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
	}
	.qa {
		padding: 1.5rem;
		border: 1px solid var(--lp-border);
		border-radius: 1.25rem;
		background: var(--lp-panel);
	}
	.qa h3 {
		margin: 0 0 var(--space-2);
		font-size: 1.1rem;
		font-weight: 650;
		line-height: 1.35;
	}
	.qa p {
		margin: 0;
		color: var(--lp-muted);
		line-height: 1.65;
	}
	@media (min-width: 48rem) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
