{
	"name": "Mainspring",
	"short_name": "Mainspring",
	"description": "Plan visually. Version it like code. TaskJuggler plans in the browser.",
	"start_url": "./app/",
	"scope": "./",
	"display": "standalone",
	"background_color": "#ece7dc",
