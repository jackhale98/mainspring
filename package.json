{
	"name": "mainspring",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "A static, offline-first PWA for TaskJuggler plans. The real TaskJuggler scheduler runs in the browser.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"dev": "astro dev",
		"build": "npm run build:engine && astro build",
		"preview": "astro preview",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json --threshold error && tsc --noEmit",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"build:engine": "node engine/build-bundle.mjs",
		"test:responsiveness": "node scripts/test-responsiveness.mjs",
		"test:golden": "node scripts/test-golden.mjs",
		"golden:record": "node engine/golden/record-native.mjs",
		"golden:verify": "node engine/golden/record-native.mjs --verify",
		"golden:wasm": "node engine/golden/run-wasm.mjs",
		"build:grammar": "node scripts/build-grammar.mjs",
		"gen:keywords": "node scripts/gen-tjp-keywords.mjs",
		"test:roundtrip": "vitest run tests/roundtrip tests/index",
		"test:fidelity": "node -e \"console.error('not implemented yet (T18)');process.exit(1)\" --"
	},
	"dependencies": {
		"@astrojs/svelte": "^9.1.0",
		"@bjorn3/browser_wasi_shim": "0.4.2",
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/language": "^6.13.1",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@lezer/common": "^1.5.3",
		"@lezer/highlight": "^1.2.5",
		"@lezer/lr": "^1.4.11",
		"@ruby/3.4-wasm-wasi": "2.10.1",
		"@ruby/wasm-wasi": "2.10.1",
		"astro": "^7.4.1",
		"svelte": "^5.57.2"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.11",
		"@axe-core/playwright": "^4.14.0",
		"@lezer/generator": "^1.8.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.20.5",
		"fast-check": "^4.10.2",
		"jsdom": "^31.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=22.22.0"
	}
}
